  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">chr</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/System/BootStartDriverInitialization</LocURI>
    </Target>
    <Data><![CDATA[<enabled/><data id="SelectDriverLoadPolicy" value="3"/>]]></Data>
  </Item>
</Replace>
