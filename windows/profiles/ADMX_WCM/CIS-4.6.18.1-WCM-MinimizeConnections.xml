<!-- Fleet policy: CIS 4.6.18.1 (L1) Ensure 'Minimize the number of simultaneous connections to the Internet or a Windows Domain' is set to 'Enabled: 3 = Prevent Wi-Fi when on Ethernet' -->
<Replace>
  <CmdID>1</CmdID>
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">chr</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/ADMX_WCM/WCM_MinimizeConnections</LocURI>
    </Target>
    <Data><![CDATA[<enabled/><data id="WCM_MinimizeConnections_Options" value="3"/>]]></Data>
  </Item>
</Replace>
