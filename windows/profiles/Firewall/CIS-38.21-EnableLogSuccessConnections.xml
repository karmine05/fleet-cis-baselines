<!-- Fleet policy: CIS 38.21 (L1) Ensure 'Enable Public Network Firewall: Enable Log Success Connections' is set to 'Enable Logging Of Successful Connections' -->
<Replace>
  <CmdID>1</CmdID>
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">bool</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Firewall/MdmStore/PublicProfile/EnableLogSuccessConnections</LocURI>
    </Target>
    <Data>true</Data>
  </Item>
</Replace>
