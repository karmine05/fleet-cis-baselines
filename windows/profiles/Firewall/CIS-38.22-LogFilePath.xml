<!-- Fleet policy: CIS 38.22 (L1) Ensure 'Enable Public Network Firewall: Log File Path' is set to '%SystemRoot%\System32\logfiles\firewall\publicfw.log' -->
<Replace>
  <CmdID>1</CmdID>
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">chr</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Firewall/MdmStore/PublicProfile/LogFilePath</LocURI>
    </Target>
    <Data>%SystemRoot%\System32\logfiles\firewall\publicfw.log</Data>
  </Item>
</Replace>
