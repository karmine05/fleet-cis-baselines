<!-- Fleet policy: CIS 38.13 (L1) Ensure 'Enable Private Network Firewall: Log File Path' is set to '%SystemRoot%\System32\logfiles\firewall\privatefw.log' -->
<Replace>
  <CmdID>1</CmdID>
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">chr</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Firewall/MdmStore/PrivateProfile/LogFilePath</LocURI>
    </Target>
    <Data>%SystemRoot%\System32\logfiles\firewall\privatefw.log</Data>
  </Item>
</Replace>
