<!-- Fleet policy: CIS 4.6.11.1 (L1) Ensure 'Hardened UNC Paths' is set to 'Enabled, with "Require Mutual Authentication", "Require Integrity", and “Require Privacy” set for all NETLOGON  -->
<Replace>
  <CmdID>1</CmdID>
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">chr</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/Connectivity/HardenedUNCPaths</LocURI>
    </Target>
    <Data><![CDATA[<enabled/><data id="Pol_HardenedPaths" value="\\*\NETLOGON&#xF000;RequireMutualAuthentication=1,RequireIntegrity=1,RequirePrivacy=1&#xF000;\\*\SYSVOL&#xF000;RequireMutualAuthentication=1,RequireIntegrity=1,RequirePrivacy=1"/>]]></Data>
  </Item>
</Replace>
