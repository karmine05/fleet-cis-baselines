  <CmdID>1</CmdID>
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">chr</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/UserRights/ReplaceProcessLevelToken</LocURI>
    </Target>
    <Data>LOCAL SERVICENETWORK SERVICE</Data>
  </Item>
</Replace>
