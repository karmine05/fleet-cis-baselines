<!-- Fleet policy: CIS 89.21 (L1) Ensure 'Increase Scheduling Priority' is set to 'Administrators, Window Manager\Window Manager Group' -->
<Replace>
  <CmdID>1</CmdID>
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">chr</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/UserRights/IncreaseSchedulingPriority</LocURI>
    </Target>
    <Data>Administrators</Data>
  </Item>
</Replace>
