<!-- Fleet policy: CIS 89.35 (L1) Ensure 'Take Ownership' is set to 'Administrators' -->
<Replace>
  <CmdID>1</CmdID>
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">chr</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/UserRights/TakeOwnership</LocURI>
    </Target>
    <Data>Administrators</Data>
  </Item>
</Replace>
