<!-- Fleet policy: CIS 89.14 (L1) Ensure 'Deny Local Log On' to include 'Guests' -->
<Replace>
  <CmdID>1</CmdID>
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">chr</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/UserRights/DenyLocalLogOn</LocURI>
    </Target>
    <Data>Guests</Data>
  </Item>
</Replace>
