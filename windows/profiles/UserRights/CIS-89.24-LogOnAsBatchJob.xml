<!-- Fleet policy: CIS 89.24 (L2) Ensure 'Log On As Batch Job' is set to 'Administrators' -->
<Replace>
  <CmdID>1</CmdID>
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">chr</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/UserRights/LogOnAsBatchJob</LocURI>
    </Target>
    <Data>Administrators</Data>
  </Item>
</Replace>
