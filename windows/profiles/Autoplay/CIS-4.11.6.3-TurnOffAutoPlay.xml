<!-- Fleet policy: CIS 4.11.6.3 (L1) Ensure 'Turn off Autoplay' is set to 'Enabled: All drives' -->
<Replace>
  <CmdID>1</CmdID>
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">chr</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/Autoplay/TurnOffAutoPlay</LocURI>
    </Target>
    <Data><![CDATA[<enabled/><data id="Autorun_Box" value="255"/>]]></Data>
  </Item>
</Replace>
