<!-- Fleet policy: CIS 4.11.6.2 (L1) Ensure 'Set the default behavior for AutoRun' is set to 'Enabled: Do not execute any autorun commands' -->
<Replace>
  <CmdID>1</CmdID>
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">chr</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/Autoplay/SetDefaultAutoRunBehavior</LocURI>
    </Target>
    <Data><![CDATA[<enabled/><data id="NoAutorun_Dropdown" value="1"/>]]></Data>
  </Item>
</Replace>
