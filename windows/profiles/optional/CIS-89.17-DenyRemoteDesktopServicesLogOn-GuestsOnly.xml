<!-- LAB-SAFE variant of CIS 89.17: Guests only: keeps local-account RDP working. Deployed and verified on this lab. -->
<Replace>
  <CmdID>1</CmdID>
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">chr</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/UserRights/DenyRemoteDesktopServicesLogOn</LocURI>
    </Target>
    <Data>Guests</Data>
  </Item>
</Replace>
