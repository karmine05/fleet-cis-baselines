<!-- Fleet policy: CIS 4.11.50.2 (L1) Ensure 'Sign-in and lock last interactive user automatically after a restart' is set to 'Disabled' -->
<Replace>
  <CmdID>1</CmdID>
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">chr</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/WindowsLogon/AllowAutomaticRestartSignOn</LocURI>
    </Target>
    <Data><![CDATA[<disabled/>]]></Data>
  </Item>
</Replace>
