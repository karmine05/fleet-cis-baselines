<!-- Fleet policy: CIS 4.11.15.2.2 (L1) Ensure 'Specify the maximum log file size (KB)' is set to 'Enabled: 196,608 or greater' -->
<Replace>
  <CmdID>1</CmdID>
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">chr</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/EventLogService/SpecifyMaximumFileSizeSecurityLog</LocURI>
    </Target>
    <Data><![CDATA[<enabled/><data id="Channel_LogMaxSize" value="196608"/>]]></Data>
  </Item>
</Replace>
